{
  "name": "123ecriture",
  "private": true,
  "description": "Application d'écriture et de productivité personnelle — 🧠 Projet Synapse",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:mobile": "pnpm --filter @123ecriture/mobile start",
    "dev:desktop": "pnpm --filter @123ecriture/desktop dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "electron", "electron-winstaller"]
  }
}
