{
  "name": "@123ecriture/desktop",
  "version": "0.1.12",
  "description": "123Ecriture — application d'écriture et de productivité (version desktop)",
  "author": "Catelina",
  "repository": "https://github.com/catelyn2332-design/123Ecriture.git",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=electron-dist --format=cjs",
    "dev": "pnpm build:electron && electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "package:linux": "pnpm build:electron && electron-builder --linux --publish never",
    "package:win": "pnpm build:electron && electron-builder --win --publish never",
    "package:mac": "pnpm build:electron && electron-builder --mac --publish never"
  },
  "dependencies": {
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.123ecriture.app",
    "productName": "123Ecriture",
    "executableName": "123ecriture",
    "publish": {
      "provider": "github"
    },
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mobile/dist",
        "to": "web-build"
      }
    ],
    "icon": "../mobile/assets/icon.png",
    "protocols": {
      "name": "123Ecriture Auth Callback",
      "schemes": ["app123ecriture"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    }
  }
}
